# ========================
# Database
# ========================


DB_HOST=''
DB_PORT=''
DB_NAME=''
DB_USER=''
DB_PASSWORD=''

# Public place evidence uses DB_* by default (RDS in production).
# Optional separate RDS connection for local development; never commit real values.
RAG_DB_HOST=''
RAG_DB_PORT=5432
RAG_DB_NAME=''
RAG_DB_USER=''
RAG_DB_PASSWORD=''
RAG_DB_SSLMODE=require
COURSE_WEB_VERIFICATION_ENABLED=false
# Reviewed source URL policies; see docs/api/shared-place-evidence.md.
PLACE_EVIDENCE_STORAGE_POLICIES=[]

# 로컬에서만 db 컨테이너 생성
COMPOSE_PROFILES=''

# 야구 SQL 조회 전용 계정. 기본 DB 계정과 다른 값을 사용합니다.
BASEBALL_DB_USER=''
BASEBALL_DB_PASSWORD=''
BASEBALL_QUERY_MAX_ROWS=''
BASEBALL_QUERY_TIMEOUT_MS=''
BASEBALL_QUERY_LOCK_TIMEOUT_MS=''
BASEBALL_QUERY_MAX_SQL_BYTES=''
BASEBALL_QUERY_MAX_RESPONSE_BYTES=''

# ========================
# backend
# ========================
DEBUG=''
DJANGO_ALLOWED_HOSTS=''
DJANGO_CSRF_TRUSTED_ORIGINS=''
OPENAI_API_KEY=''
OPENROUTER_API_KEY=''
# Public research only; no browser profiles or credentials are shared.
WEB_RESEARCH_ENABLED=false
JEV_MCP_URL=http://jev-browser:8080/mcp
# Dev/prod auto-deploy starts jev-browser (web-research profile) even when general research is off.
# Set the same nonempty runtime Bearer token for backend/reader in the server .env before deployment.
# Empty fails closed; never commit real values. See docs/JEV_CUSTOM_READER.md.
JEV_MCP_TOKEN=''
RESEARCH_MODEL=gpt-6-luna
RESEARCH_BASE_URL=https://api.openai.com/v1
RESEARCH_API_KEY=''
JEV_TIMEOUT_SECONDS=120
# Optional Docker MCP request summaries only; separate switch from backend tracing.
# JEV_LANGSMITH_TRACING=true
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=''  # Runtime only; never bake into the image or commit a real key.
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=kbo-rag
EMBEDDING_MODEL=text-embedding-3-small

# Private persistent Qdrant; use a generated secret, never publish its ports.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=''
QDRANT_DOCUMENT_COLLECTION=kbo_documents_openai
CHAT_CHECKPOINT_SIGNING_KEY=''

# Chat allowances are tokens, not credits: 1000 tokens = 1 credit.
# Guest: lifetime 500 credits; member: 999999 credits per month (USAGE_TIMEZONE).
# Use integer token counts; keep these values non-empty for local env_file loading.
USAGE_GUEST_TOKENS=500000
USAGE_MEMBER_MONTHLY_TOKENS=999999000

# Local Docker uses Mailpit (SMTP 1025, web UI http://localhost:8025).
# Replace these values with your SMTP provider settings outside local development.

EMAIL_BACKEND=''
EMAIL_HOST=''
EMAIL_PORT=''
EMAIL_HOST_USER=''
EMAIL_HOST_PASSWORD=''
EMAIL_USE_TLS=''
# Leave blank to fall back to EMAIL_HOST_USER, then webmaster@localhost.
DEFAULT_FROM_EMAIL=''


# Gmail deployment example (use a Google app password after enabling 2-Step Verification,
# never the normal Google account password):

# EMAIL_HOST=''
# EMAIL_PORT=''
# EMAIL_USE_TLS=''
# EMAIL_HOST_USER=''
# EMAIL_HOST_PASSWORD=''
# DEFAULT_FROM_EMAIL=''

# For local output without SMTP: EMAIL_BACKEND=''
# Local Mailpit web UI only; replace this sample outside local development.
MAILPIT_UI_AUTH=''


# ========================
# Frontend
# ========================
AUTH_FRONTEND_ORIGIN=''
NEXT_PUBLIC_API_URL=''
NEXT_ALLOWED_DEV_ORIGINS=''

# Frontend map: public JavaScript SDK key (register the app domain in Kakao)
NEXT_PUBLIC_KAKAO_MAP_KEY=''

# Next server only: route directions and Korea Tourism Organization places
KAKAO_REST_API_KEY=''
# 관광공사 API키
TOUR_API_KEY=''


# Youtube API 키
YOUTUBE_API_KEY=''

KMA_API_KEY=''

# Optional collection-script API keys; never commit real values.
GOOGLE_PLACES_API_KEY=''
PARK_API_KEY=''
SBIZ_API_KEY=''

# Chat SSE: actual progress timeout; 10s keep-alives do not extend this deadline.
CHAT_STREAM_IDLE_TIMEOUT_SECONDS=300

# 숙박: 로컬 Django는 Node 24 + 설치된 Google Chrome, Compose는 서버 MCP 브라우저 사용.
# 사용자 PC/휴대폰에는 Chrome 설치가 필요하지 않다.
LODGING_CHROME_TRANSPORT=local
# 자동 탐지 실패 시에만 설정. 실제 .env 값이나 자격증명은 커밋하지 않는다.
LODGING_CHROME_PATH=
LODGING_CHROME_NODE=node
# Compose lodging-warmer: 빈 값이면 지원 구장 전체, 쉼표로 범위 제한 가능 (예: JAMSIL,SAJIK).
# 공개 원문만 미리 갱신하며 사용자 요청이 들어오면 브라우저를 양보한다.
LODGING_WARM_STADIUMS=

# Private local image storage
MINIO_ROOT_USER=''
MINIO_ROOT_PASSWORD=''
COMMUNITY_IMAGE_S3_BUCKET=''
COMMUNITY_IMAGE_S3_REGION=''
MINIO_API_PORT=''
MINIO_CONSOLE_PORT=''
